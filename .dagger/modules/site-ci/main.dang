"""CI checks for adityaai.dev. Mirrors .github/workflows/ci.yml."""
type SiteCi {
  pub source: Directory!
  pub nodeImage: String!

  new(ws: Workspace!, nodeImage: String! = "node:22-bookworm-slim") {
    self.source = ws.directory("/", exclude: ["node_modules", "dist", ".git", ".dagger", ".vercel"])
    self.nodeImage = nodeImage
    self
  }

  """Source tree with dependencies installed by npm ci."""
  let deps: Container! {
    container
      .from(nodeImage)
      .withMountedCache("/root/.npm", cacheVolume("site-npm"))
      .withWorkdir("/app")
      .withFile("/app/package.json", source.file("package.json"))
      .withFile("/app/package-lock.json", source.file("package-lock.json"))
      .withExec(["npm", "ci", "--no-audit", "--no-fund"])
      .withDirectory("/app", source)
  }

  """Type-check with tsc (npm run lint)."""
  pub typecheck: Void @check {
    deps.withExec(["npm", "run", "lint"]).sync
    null
  }

  """Run the unit tests (npm test)."""
  pub test: Void @check {
    deps.withExec(["npm", "test"]).sync
    null
  }

  """Build, then confirm generated files match the commit and dist passes the guard."""
  pub build: Void @check {
    deps
      .withExec(["sh", "-c", "mkdir -p /orig && cp public/llms.txt scripts/articles-meta.json /orig/"])
      .withExec(["npm", "run", "build"])
      .withExec(["sh", "-c", """
        set -e
        cmp /orig/llms.txt public/llms.txt || { echo "public/llms.txt is stale; run npm run build and commit"; exit 1; }
        cmp /orig/articles-meta.json scripts/articles-meta.json || { echo "scripts/articles-meta.json is stale"; exit 1; }
        node --input-type=module -e '
          import fs from "node:fs";
          import { guardHits } from "./scripts/upstream-guard.mjs";
          for (const f of ["dist/index.html", "dist/404.html", "dist/sitemap.xml", "dist/llms.txt", "dist/upstream/index.html"]) {
            if (!fs.existsSync(f) || fs.statSync(f).size === 0) throw new Error("Missing or empty build artifact: " + f);
          }
          const h = fs.readFileSync("dist/upstream/index.html", "utf8");
          if (guardHits(h).length > 0 || /approv/i.test(h)) throw new Error("upstream guard failed");
          const js = fs.readdirSync("dist/assets").filter((f) => /^index-.*\.js$/.test(f));
          if (js.length === 0) throw new Error("Missing dist/assets/index-*.js bundle");
          for (const f of js) {
            const s = fs.readFileSync("dist/assets/" + f, "utf8");
            if (s.includes("import.meta.glob")) throw new Error(f + " has untransformed import.meta.glob");
            if (!s.includes("/src/content/articles/shared-caches-beat-sandbox-walls.md")) throw new Error(f + " is missing the article loader map");
          }
          console.log("dist ok");
        '
        """])
      .sync
    null
  }
}
