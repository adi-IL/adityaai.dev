# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Required for newsletter, article feedback, and virtual coffee.
# https://resend.com
RESEND_API_KEY="re_..."

# Optional: Resend Audience / Segment ID for confirmed newsletter contacts.
# RESEND_AUDIENCE_ID="aud_..."

# Optional: HMAC secret for double-opt-in confirm links (defaults to RESEND_API_KEY).
# SUBSCRIBE_SECRET="long-random-string"

# Public site origin used inside confirmation emails (no trailing slash).
# APP_URL="https://www.adityaai.dev"

# Inbox for leads, feedback, confirmed subscribers.
NOTIFY_EMAIL="aiexpert@adityaai.dev"

# ─── Lab guide chatbot (same pattern as sentinel-main) ────────────────────────
# Auth order in lib/vertex.ts (mirrors sentinel api/_shared/gemini.ts):
#   1) GEMINI_API_KEY or GOOGLE_API_KEY  → Google AI Studio
#   2) else Vertex AI with SA JSON written to /tmp for ADC
#
# Copy these from Vercel project "sentinel-main" (Production):
#   GCP_PROJECT_ID, GCP_LOCATION, GCP_CREDENTIALS_JSON
#
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
# Full service-account JSON as a single line / env string (sensitive):
# GCP_CREDENTIALS_JSON='{"type":"service_account",...}'
#
# Aliases also accepted:
# GOOGLE_CLOUD_PROJECT=...
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#
# GEMINI_MODEL="gemini-3.7-flash"
# CHAT_ENABLE_SEARCH="true"
# GEMINI_API_KEY="..."   # optional override; skips Vertex if set

# ─── Local server ─────────────────────────────────────────────────────────────
# Local Vertex: gcloud ADC works without GCP_CREDENTIALS_JSON.
#   gcloud auth application-default login
# PORT=3000
