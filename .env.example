# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Required for newsletter, article feedback, virtual coffee, and c2h-report.
# https://resend.com
RESEND_API_KEY="re_..."

# Optional: Resend Audience / Segment ID for confirmed newsletter contacts.
# RESEND_AUDIENCE_ID="aud_..."

# Optional: HMAC secret for double-opt-in confirm links (defaults to RESEND_API_KEY).
# SUBSCRIBE_SECRET="long-random-string"

# Public site origin used inside confirmation emails (no trailing slash). Alias: SITE_URL.
# APP_URL="https://www.adityaai.dev"

# Inbox for leads, feedback, c2h reports, and confirmed subscribers.
NOTIFY_EMAIL="aiexpert@adityaai.dev"

# ─── Lab guide chatbot ────────────────────────────────────────────────────────
# Auth order in lib/vertex.ts:
#   1) GEMINI_API_KEY or GOOGLE_API_KEY  → Google AI Studio
#   2) else Vertex AI with SA JSON written to /tmp for ADC
#
# Set these in the host env (Vercel / local .env.local). Never commit real values.
#
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="global"
# Full service-account JSON as a single line / env string (sensitive):
# GCP_CREDENTIALS_JSON='{"type":"service_account",...}'
#
# Aliases also accepted:
# GOOGLE_CLOUD_PROJECT=... (or GCLOUD_PROJECT, VITE_GCP_PROJECT_ID, GCP_PROJECT)
# GOOGLE_CLOUD_LOCATION=global (or VERTEX_LOCATION)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}' (or GOOGLE_CREDENTIALS_JSON, GOOGLE_APPLICATION_CREDENTIALS)
#
# GEMINI_MODEL="gemini-3.7-flash"
# CHAT_ENABLE_SEARCH="true"
# GEMINI_API_KEY="..."   # optional override; skips Vertex if set

# ─── Local server & scripts ───────────────────────────────────────────────────
# Local Vertex: gcloud ADC works without GCP_CREDENTIALS_JSON.
#   gcloud auth application-default login
# PORT=3000
# DISABLE_HMR="true"     # optional Vite HMR toggle
# LEDGER_SRC="https://raw.githubusercontent.com/adi-IL/adi-IL/main/data/ledger.json"
