# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Required for newsletter, article feedback, and virtual coffee.
# https://resend.com
RESEND_API_KEY="re_..."

# Optional: Resend Audience / Segment ID for confirmed newsletter contacts.
# Create an audience in the Resend dashboard, then paste its ID here.
# Without this, contacts are still created in the global Contacts list.
# RESEND_AUDIENCE_ID="aud_..."

# Optional: separate HMAC secret for double-opt-in confirm links.
# If unset, RESEND_API_KEY is used as the signing secret.
# SUBSCRIBE_SECRET="long-random-string"

# Public site origin used inside confirmation emails (no trailing slash).
# APP_URL="https://www.adityaai.dev"

# Inbox for new leads, article feedback, and confirmed subscribers.
# Defaults to aiexpert@adityaai.dev
NOTIFY_EMAIL="aiexpert@adityaai.dev"

# ─── Local server ─────────────────────────────────────────────────────────────
# PORT=3000
